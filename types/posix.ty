// POSIX constants (all c_int)
STDIN_FILENO: c_int
STDOUT_FILENO: c_int
STDERR_FILENO: c_int
WNOHANG: c_int
SIGKILL: c_int
SIGINT: c_int
SIGTERM: c_int
SIGCHLD: c_int
SIG_BLOCK: c_int
SIG_UNBLOCK: c_int
O_RDONLY: c_int
O_WRONLY: c_int
O_CREAT: c_int
O_NONBLOCK: c_int
F_SETFL: c_int
F_SETFD: c_int
F_DUPFD: c_int
FD_CLOEXEC: c_int
S_IRUSR: c_int
S_IWUSR: c_int
POLLIN: c_int
POLLERR: c_int
POLLHUP: c_int
_SC_OPEN_MAX: c_int

// POSIX process functions
fork: [] --> c_int
waitpid: [any, any, any] --> c_int
kill: [any, any] --> c_int
raise: [any] --> c_int
execvp: [any, any] --> c_int
pipe: [any] --> c_int
usleep: [any] --> c_int
sysconf: [any] --> c_int

// POSIX file descriptor functions
open: ([any, any] --> c_int) & ([any, any, any] --> c_int)
close: [any] --> c_int
read: [any, any, any] --> c_int
write: [any, any, any] --> c_int
dup2: [any, any] --> c_int
fcntl: ([any, any] --> c_int) & ([any, any, any] --> c_int)
poll: [any, any, any] --> c_int

// POSIX signal functions
sigemptyset: [any] --> c_int
sigaddset: [any, any] --> c_int
sigprocmask: [any, any, any] --> c_int
signal: [any, any] --> any

// POSIX wait status macros
WIFEXITED: [any] --> c_bool
WEXITSTATUS: [any] --> c_int
WTERMSIG: [any] --> c_int

// POSIX string functions
strerror: [any] --> c_string
strsignal: [any] --> c_string
strdup: [any] --> c_string

// POSIX stdio
stdin: c_ptr
stdout: c_ptr
stderr: c_ptr
fdopen: [any, any] --> any
fprintf: ([any, any] --> c_int) & ([any, any, any] --> c_int) & ([any, any, any, any] --> c_int)
fclose: [any] --> c_int
fopen: [any, any] --> any
fflush: [any] --> c_int
fwrite: [any, any, any, any] --> c_int
// snprintf is variadic; enumerate common arities (buf, size, fmt[, args...])
snprintf: ([any, any, any] --> c_int) & ([any, any, any, any] --> c_int) & ([any, any, any, any, any] --> c_int) & ([any, any, any, any, any, any] --> c_int)

// POSIX misc
// NB: errno is intentionally *not* declared here. It is a mutable lvalue
// (code does [errno = 0]), but a .ty binding is immutable, so installing it
// would make every [errno = ...] crash with "Cannot assign to an immutable
// variable". Left undeclared, it falls back to a fresh mutable variable.
gettimeofday: [any, any] --> c_int
setpgid: [any, any] --> c_int
prctl: [any, any] --> c_int

// C stdlib memory management
// c_int_na and not c_int because we currently type int arg of functions as c_int_na. 
malloc: [c_int_na] --> c_ptr
calloc: [c_int_na, c_int_na] --> c_ptr
realloc: [c_ptr, c_int_na] --> c_ptr
free: [c_ptr] --> c_void

// C stdlib time
time: [any] --> c_int

// C stdlib limits/float constants
INT_MAX: c_int
INT_MIN: c_int
DBL_MAX: c_double
DBL_MIN: c_double


// C stdlib string
strlen: [c_string] --> c_int
strcmp: [c_string, c_string] --> c_int // TODO: we should make it work on string singletons also, to be able to check for equality at least
strncmp: [c_string, c_string, any] --> c_int
strcpy: [any, any] --> c_string

// C stdlib math
fmin: [c_double, c_double] --> c_double

// POSIX sockets / netdb
__SOCKADDR_COMMON: [any] --> c_void
socket: [any, any, any] --> c_int
bind: [any, any, any] --> c_int
getaddrinfo: [any, any, any, any] --> c_int
freeaddrinfo: [any] --> c_void
htonl: [any] --> c_int
htons: [any] --> c_int
FD_ZERO: [any] --> c_void
INADDR_ANY: c_int
