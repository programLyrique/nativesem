// ===== Reading this file =====
//
// Types are written in RSTT's concrete syntax. A few conventions changed with
// the current version of the type algebra and are worth spelling out:
//
//   * `[T1, T2]` is a tuple -- how the arguments of a C function are passed
//     (it used to be written `t(T1, T2)`); `[]` is the empty tuple, i.e. the
//     argument list of a nullary C function.
//   * `INT`, `DBL`, `LGL`, `CHR`, `CLX`, `RAW` denote *exactly* one R vector
//     mode. The lowercase spellings (`int`, `dbl`, ...) denote that mode plus
//     every mode that coerces up to it, so `chr` is in fact every mode and
//     `p(chr)` is all of `prim`. Use the uppercase ones for SEXP types.
//   * Vector lengths are no longer part of the algebra. `v(P)` is a vector of
//     any length, `v1(P)` a length-1 vector (a scalar), and only `v1` may
//     carry a refined element type: a non-scalar vector's element type must be
//     a whole mode, so `v(^INT)`, `v("a")` or `v(42L)` do not exist.
//     Signatures that used to track a length (`v[n](P)`, `v[INT('n)](P)`,
//     `v0(P)`) keep the scalar case whenever it is the useful one and widen to
//     `v(P)` otherwise.
//   * `prim` is a builtin (the union of the six `p(MODE)` components), so it
//     is no longer defined as an alias here.

expr = {lang|sym}
any_r_not_vec = env | null | sym | list | lang | (empty -> any) | expr | externalptr | p(CHR)
//any_sexp = any_r_not_vec | vec // the old definition: but in Defs, it was defined as p(chr) | Attr.any
any_sexp = p(CHR) | attr | null | sym //
// This is maybe too unconstrained as sexp can have content be a C type, not only a R type. 
// Maybe it would be better to tighten Defs.any_sexp...

error: any --> empty
fail: empty --> any

isInteger: ([v(INT)] --> c_true) & ([~v(INT)] --> c_false)
isReal: ([v(DBL)] --> c_true) & ([~v(DBL)] --> c_false)
isLogical: ([v(LGL)] --> c_true) & ([~v(LGL)] --> c_false)
IS_SCALAR: ([v1('b)] --> c_true) & ([v('b) \ v1('b)] --> c_false)

// A vector of unknown length may contain NA, so its data pointer is
// *c_int_na; only a scalar can be known NA-free.
INTEGER: ([v1(^INT)] --> *c_int) & ([v(INT)] --> *c_int_na)
INTEGER_RO: ([v1(^INT)] --> *c_int) & ([v(INT)] --> *c_int_na)
REAL: [v(DBL)] --> *c_double
REAL_RO: [v(DBL)] --> *c_double
LOGICAL: [v(LGL)] --> *c_int
LOGICAL_RO: [v(LGL)] --> *c_int


// Lengths are not tracked anymore; only the scalar case stays exact.
LENGTH: ([vec1] --> c(1)) & ([vec] --> c_int) & ([p(CHR)] --> c_int) // length actually returns the length of the string (without '\0)
XLENGTH: ([vec1] --> c(1)) & ([vec] --> c_int) & ([p(CHR)] --> c_int)
xlength: ([vec1] --> c(1)) & ([vec] --> c_int) & ([p(CHR)] --> c_int)
envlength: [env] --> c_int
nrows: [vec | list | expr | null | lang] --> c_int
ncols: [vec | list | expr | null | lang] --> c_int

// there is also a special case for VECSXP (list) that is coded in OCaml.
// The STRSXP overload seeds elements to "" (R_BlankString) — R's actual initial
// value for a fresh STRSXP (see R src/main/memory.c allocVector3: STRSXP slots
// are set to R_BlankString, VECSXP/EXPRSXP to R_NilValue). This is the sound
// fresh-vector type, and lets SET_STRING_ELT's union narrow from "" rather than
// from chr-top. Only a scalar can record that seed, hence the c(1) overloads.
allocVector: (['a & prim, c(1)] --> v1('a)) & (['a & prim, c_int] --> v('a)) & ([p(CHR), c(1)] --> v1("")) & ([list, 'b] --> list)
R_allocResizableVector: (['a & prim, c(1)] --> v1('a)) & (['a & prim, c_int] --> v('a)) & ([list, 'b] --> list) // we might have to support the special case as for the function above, but not the case yet
allocSExp: ['a & any_r_not_vec] --> 'a
install: [c_string] --> sym

// when the names are statically known, we can return a more precise type (handled on the OCaml side)
mkNamed: (['a & prim, *c_string] --> v('a)) & ([list, *c_string] --> list)

VECTOR_ELT: [{ 'r}, c_int] --> 'r
SET_VECTOR_ELT: ([{ 'r}, c_int, 'a] --> { 'r | 'a}) & ([expr, c_int, lang | sym] --> expr)

isVector: ([v('a) | expr | list] --> c_true) & ([any_r_not_vec \ (list & expr)] --> c_false)
isVectorList: ([list | expr] --> c_true) & ([v('a) | any_r_not_vec \ (list | expr)] --> c_false)

ScalarReal: [c_double | c_int] --> DBL1
ScalarInteger: ([c_int('a)] --> v1(^INT('a))) & ([c_na] --> v1(INT \ ^INT))
ScalarLogical: ([c(0)] --> v1(ff)) & ([c_na] --> v1(LGL \ ^LGL)) & ([c_int \ c(0)] --> v1(tt))

// Strings 
na_string = p(CHR \ ^CHR)
mkString: [c_string('a)] --> v1(^CHR('a))
ScalarString: [p(CHR & 'a)] --> v1(CHR & 'a)
mkChar: ([c_string('a)] --> p(^CHR('a))) & ([c_null] --> na_string)
mkCharLen: ([c_string('a), c_int] --> p(^CHR('a))) & ([c_null, c_int] --> na_string)
mkCharCE: ([c_string('a), any] --> p(^CHR('a))) & ([c_null, any] --> na_string) // the 2nd argument is the encoding
mkCharLenCE: [c_string('a), c_int, any] --> p(^CHR('a))
// ^CHR('a) (NA-free) so NA_STRING falls to the c("NA") overload, not c_string(empty)=empty.
// The last, unrefined [p(CHR)] arrow is what makes the function applicable to a
// value whose type is still an inference variable: rstt only lets a variable be
// instantiated with a *whole* primitive component (see Rstt.TyOp.normalize_subst),
// so a domain made solely of the two halves of CHR would never be reachable from
// an unconstrained SEXP argument.
R_CHAR: ([p(^CHR('a))] --> c_string('a)) & ([p(CHR \ ^CHR)] --> c("NA")) & ([p(CHR)] --> c_string | c("NA"))
CHAR: ([p(^CHR('a))] --> c_string('a)) & ([p(CHR \ ^CHR)] --> c("NA")) & ([p(CHR)] --> c_string | c("NA"))
STRING_ELT: [v(CHR & 'a), c_int] --> p('a)
// The scalar overload keeps the element type exact for a length-1 STRSXP,
// which is what the class/names recovery in defs.ml reads back.
SET_STRING_ELT: ([v1(CHR & 'e), c_int, p(CHR & 's)] --> v1((CHR & 'e) | (CHR & 's))) & ([v(CHR & 'e), c_int, p(CHR & 's)] --> v((CHR & 'e) | (CHR & 's)))
StringBlank: ([p("")] --> c_true) & ([p(CHR \ "")] --> c_false) & ([null] --> c_true) 
NA_STRING: na_string
asChar: ([vec] --> p(CHR)) & ([p(CHR) & 'a] --> 'a) & ([sym] --> p(CHR)) & ([any_r_not_vec \ (sym | p(CHR))] --> na_string)
type2char:  ([p(INT)] --> c("integer")) & ([p(DBL)] --> c("double")) & ([p(LGL)] --> c("logical")) & ([p(CHR)] --> c("character")) & ([p(CLX)] --> c("complex")) & ([p(RAW)] --> c("raw")) & ([list] --> c("list")) & ([null] --> c("NULL")) & ([env] --> c("environment")) & ([sym] --> c("symbol")) & ([lang] --> c("language")) & ([expr] --> c("expression")) & ([empty -> any] --> c("closure"))
isString: ([v(CHR)] --> c_true) & ([any_sexp \ v(CHR)] --> c_false)
getCharCE: [p(CHR)] --> c_int
// cetype_t encoding constants (R's Rinternals.h); the encoding argument of
// mkCharCE / mkCharLenCE and the result of getCharCE.
CE_NATIVE: c(0)
CE_UTF8: c(1)
CE_LATIN1: c(2)
CE_BYTES: c(3)
CE_SYMBOL: c(5)
CE_ANY: c(99)
translateCharUTF8: [p(CHR)] --> c_string
translateChar: [p(CHR)] --> c_string
PRINTNAME: [sym] --> p(CHR)
STRING_PTR_RO: [v(CHR)] --> *p(CHR)
STRING_PTR: [v(CHR)] --> *p(CHR)

Rprintf: any --> c_void // variadic

// Environments
R_GlobalEnv: env
R_EmptyEnv: env
R_BaseEnv: env
R_BaseNamespace: env
R_NewEnv: [env, c_int, c_int] --> env
R_GetCurrentEnv: [] --> env
R_ParentEnv: [env] --> env
R_UnboundValue: sym
R_NamespaceRegistry: env
R_FindNamespace: [any] --> env
R_IsNamespaceEnv: [env] --> c_bool

// R API: internal symbols (getAttrib/setAttrib/defineVar args)
R_LevelsSymbol: sym
R_ClassSymbol: sym
R_NamesSymbol: sym
R_DimSymbol: sym
R_DimNamesSymbol: sym
R_RowNamesSymbol: sym
R_BraceSymbol: sym
R_BracketSymbol: sym
R_Bracket2Symbol: sym
R_DoubleColonSymbol: sym

// R API: evaluation / binding
Rf_eval: [any_sexp, env] --> any
Rf_defineVar: [sym, any_sexp, env] --> c_void
Rf_GetOption1: [sym] --> any_sexp
R_getVar: [sym, env, c_bool] --> any_sexp

// R API: reflection / printing
Rf_PrintValue: [any_sexp] --> c_void
Rf_type2str: [any] --> sym // similar to TYPEOF for the argument. Fix accordingly
Rf_asS4:     [any_sexp] --> any_sexp
Rf_isS4:     [any_sexp] --> c_bool
Rf_onintr:   [] --> c_void
Rf_lengthgets: [vec | list | lang, c_int] --> any_sexp
Rf_ParseVector: [any_sexp, c_int, *c_int, CHR1] --> any_sexp // the 2 sexp arguments are probably STRSXP actually and the return type, an expr?
R_ParseVector: [any_sexp, c_int, *c_int, any_sexp] --> expr
R_GetBindingType: [sym, env] --> c_int

// R API: external pointers (extended)
R_ClearExternalPtr: [externalptr] --> c_void
R_SetExternalPtrAddr: [externalptr, *any] --> c_void
R_ExternalPtrTag: [externalptr] --> any_sexp
R_ExternalPtrProtected: [externalptr] --> any_sexp
R_RegisterCFinalizerEx: [externalptr, any_sexp --> [] | c_void, c_bool] --> c_void

// R API: closures
R_ClosureExpr: [empty -> any] --> lang
R_ClosureEnv: [empty -> any] --> env
R_ClosureFormals: [empty -> any] --> lang | null
R_mkClosure: [lang | null, any_sexp, env] --> (any -> any)

// R API: ALTREP
// R_altrep_class_t is [typedef struct { SEXP ptr; } R_altrep_class_t;] — modelled
// as a single-field C struct so [R_new_altrep] callers carrying a real
// [R_altrep_class_t] (rather than [any]) get a meaningful first-arg type.
ALTREP: [any_sexp] --> c_bool
R_altrep_data2: [any_sexp] --> any_sexp
R_new_altrep: [s({ ptr : any_sexp }), any_sexp, any_sexp] --> any_sexp

// R API: misc
R_CheckStack2: [c_int] --> c_void
R_GetCCallable: [c_string, c_string] --> any
MAYBE_REFERENCED: [any_sexp] --> c_int
vmaxget: [] --> *any
Rf_charIsASCII: [p(CHR)] --> c_bool
R_new_custom_connection: [c_string, c_string, c_string, *any] --> any_sexp

// Casts
asLogical: [any_sexp] --> c_true | c_false
asInteger: [any_sexp] --> c_int
// Rf_asCharacterFactor: maps a factor's integer codes through its levels, so the
// input must be a factor (v(INT) with class factor; ... allows ordered factors).
// Result is a STRSXP whose elements are the level strings (level content not
// projected here -- base.ty has no attribute-record domain syntax).
asCharacterFactor: [v(INT)<factor, ...>] --> v(CHR)

// Pairlists and language
list2: [any_sexp, any_sexp] --> lang
isPairList: ([lang] --> c_true) & ([~lang] --> c_false)
lang1: [any_sexp] --> lang
lang2: [any_sexp, any_sexp] --> lang
Rf_lang3: [any_sexp, any_sexp, any_sexp] --> lang
Rf_lang4: [any_sexp, any_sexp, any_sexp, any_sexp] --> lang

// Attributes
// TODO: we also support attributes in the type algebra, so add it!
getAttrib: [any_sexp, sym] --> any_sexp
setAttrib: [any_sexp, sym, any] --> any_sexp
ANY_ATTRIB: [any_sexp] --> c_int
CLEAR_ATTRIB: [any_sexp] --> c_void
SHALLOW_DUPLICATE_ATTRIB: [any_sexp, any_sexp] --> c_void
// 2nd argument is [SEXP (*FUN)(SEXP, SEXP, void*)] but the type system has
// no first-class function-pointer-with-data abstraction, so the callback is
// left as [any].
R_mapAttrib: [any_sexp, any, *any] --> any_sexp

[]<-: ([*'a, c_int_na, 'a] --> *'a) & ([c_string, c_int_na, c_char] --> c_string)
[]: ([*'a, c_int_na] --> 'a) & ([c_string, c_int_na] --> c_char)

PROTECT_INDEX: c_int

PROTECT: ['a] --> 'a
UNPROTECT: [c_int] --> c_void
REPROTECT: [any_sexp, c_int] --> c_void
PROTECT_WITH_INDEX: [any_sexp, *c_int] --> c_void
R_PreserveObject: [any_sexp] --> c_void
R_ReleaseObject: [any_sexp] --> c_void

// Arithmetic (including pointer arithmetic for strings)

+__2: ([c_int, c_int] --> c_int) & ([c_double, c_double] --> c_double) & ([any, any] --> any) & ([c_int_na, c_int_na] --> c_int_na) & ([c_int_na, c_int] --> c_int_na) & ([c_int, c_int_na] --> c_int_na) & ([c_string, c_int] --> c_string) & ([c_char, c_int] --> c_char) & ([c_char, c_char] --> c_char) & ([*'a, c_int_na] --> *'a) & ([c_int_na, *'a] --> *'a)

-__2: ([c_int, c_int] --> c_int) & ([c_double, c_double] --> c_double) & ([any, any] --> any) & ([c_int_na, c_int_na] --> c_int_na) & ([c_int_na, c_int] --> c_int_na) & ([c_int, c_int_na] --> c_int_na) & ([c_string, c_int] --> c_string) & ([c_string, c_string] --> c_int)

*__2: ([c_int, c_int] --> c_int) & ([c_double, c_double] --> c_double) & ([any, any] --> any) & ([c_int_na, c_int_na] --> c_int_na) & ([c_int_na, c_int] --> c_int_na) & ([c_int, c_int_na] --> c_int_na)

%__2: [c_int, c_int] --> c_int
/__2: ([c_int, c_int] --> c_int) & ([c_double, c_double] --> c_double) & ([any, any] --> any)
|__2: ([c_int, c_int] --> c_int) & ([c_int_na, c_int] --> c_int)
^__2: ([c_int, c_int] --> c_int) & ([c_int_na, c_int] --> c_int)
&__2: ([c_int, c_int] --> c_int) & ([c_int_na, c_int] --> c_int)
~__1: ([c_int] --> c_int) & ([c_int_na] --> c_int_na)
<<__2: ([c_int, c_int] --> c_int) & ([c_int_na, c_int] --> c_int)
>>__2: ([c_int, c_int] --> c_int) & ([c_int_na, c_int] --> c_int)


// ['a] --> 'a would also include singleton types, which is not semantically correct for numbers for instance
++__1: ([c_int] --> c_int) & ([c_int_na] --> c_int_na) & ([c_double] --> c_double) & ([*'a] --> *'a) & ([c_string] --> c_string)
--__1: ([c_int] --> c_int) & ([c_int_na] --> c_int_na) & ([c_double] --> c_double) & ([*'a] --> *'a) & ([c_string] --> c_string)

*__1: ([*'a] --> 'a) & ([c_string] --> c_char) // rather ([*'a \ c_null] -> 'a) & ([c_string] -> c_char) but would require dyn for the c_null overload to be added
&__1: ['a] --> *'a

-__1: ([c_int] --> c_int) & ([c_double] --> c_double) & ([any, any] --> any) & ([c_int_na] --> c_int_na)

abs: [c_int] --> c(0 ..) 

// TODO: put the actual value here?
R_INT_MIN: c_int
R_INT_MAX: c_int
R_LEN_T_MAX: c_int
R_SSIZE_MAX: c_int
R_NaN: c_double
R_PosInf: c_double
R_NegInf: c_double
// NaN / finiteness predicates (libm <math.h> + R_ext/Arith.h); int-ish 0/1 -> c_bool.
isnan: [c_double] --> c_bool
ISNAN: [c_double] --> c_bool
isfinite: [c_double] --> c_bool
R_FINITE: [c_double] --> c_bool
R_IsNA: [c_double] --> c_bool
sizeof: [any] --> c_int
// libm <math.h>: rounds toward -inf, result is still a double.
floor: [c_double] --> c_double

INT64_MIN: c_int


Rf_envlength: [env] --> c_int
CDR: [lang] --> any_sexp

// Boolean operators and comparisons
||__2: ([c_true, c_true] | [c_true, c_false] | [c_false, c_true] --> c_true) & ([c_false, c_false] --> c_false)
&&__2: ([c_false, c_false] | [c_true, c_false] | [c_false, c_true] --> c_false) & ([c_true, c_true] --> c_true)
==__2: [any, any] --> c_bool
!=__2: [any, any] --> c_bool
!__1: ([c_true] --> c_false) & ([c_false] --> c_true) & ([c(.. -1) | c(1 ..)] --> c_false) & ([c_null] --> c_true) & ([*any \ c_null] --> c_false) & ([c_string] --> c_false)
<__2: ([c_int, c_int] --> c_bool) & ([c_double, c_double] --> c_bool) & ([any, any] --> c_bool)
>__2: ([c_int, c_int] --> c_bool) & ([c_double, c_double] --> c_bool) & ([any, any] --> c_bool)
<=__2: ([c_int, c_int] --> c_bool) & ([c_double, c_double] --> c_bool) & ([any, any] --> c_bool)
>=__2: ([c_int, c_int] --> c_bool) & ([c_double, c_double] --> c_bool) & ([any, any] --> c_bool)

// TODO: add more non vector types for the 2nd overload
TYPEOF: ([v('a)] --> 'a) & (['b & ~vec & any_r_not_vec] --> 'b)

NA_INTEGER: c_int_na
NA_LOGICAL: c_int_na
// No c_double_na token; mirror R_NaN's plain c_double (double-NA is a NaN bit pattern).
NA_REAL: c_double

TRUE: c_true
FALSE: c_false
R_NilValue: null

INTSXP: p(INT)
REALSXP: p(DBL)
RAWSXP: p(RAW)
CPLXSXP: p(CLX)
STRSXP: p(CHR)
LGLSXP: p(LGL)
NILSXP: null
VECSXP: list
EXPRSXP: {lang|sym}
CLOSXP: empty -> any
BUILTINSXP: empty -> any
SPECIALSXP: empty -> any
CHARSXP: p(CHR)
SYMSXP: sym
LISTSXP: lang
LANGSXP: lang
ENVSXP: env
ANYSXP: any_sexp
DOTSXP: any
EXTPTRSXP: externalptr

// Standard predefined preprocessor macros. The concrete file/line/date/time
// values are never load-bearing for typing, so we bind them to the
// non-singleton C types.
__FILE__: c_string
__LINE__: c_int
__DATE__: c_string
__TIME__: c_string

// R API: error/warning
Rf_error: any --> empty // redundant with error but like fail. The best would be to generate 2 versions of the function and pick the one which type checks?
errorcall: ([any, any] --> empty) & ([any, any, any] --> empty) & ([any, any, any, any] --> empty)
warningcall: ([any, any] --> c_void) & ([any, any, any] --> c_void) & ([any, any, any, any] --> c_void)

// R API: type tests
isFunction: ([empty -> any] --> c_true) & ([~(empty -> any)] --> c_false)

// R API: evaluation
R_ToplevelExec: [any, *any] --> c_bool
R_tryEval: [any_sexp, env, *c_int] --> any_sexp
R_CheckUserInterrupt: [] --> c_void

// R API: pairlists
LCONS: [any_sexp, lang | null] --> lang
CONS: [any_sexp, lang | null] --> lang
cons: [any_sexp, lang | null] --> lang
lcons: [any_sexp, lang | null] --> lang
CAR: [lang] --> any_sexp
CADR: [lang] --> any_sexp
CDDR: [lang] --> any_sexp
TAG: [lang] --> any_sexp
SET_TAG: [lang, any_sexp] --> c_void
SETCAR: [lang, any_sexp] --> any_sexp
SETCDR: [lang, any_sexp] --> any_sexp

// R API: raw vectors
RAW: [v(RAW)] --> *c_int

// R API: complex / list vector accessors
// Rcomplex is [typedef struct { double r; double i; } Rcomplex;] so the
// pointee is modelled as the matching two-field C struct — code that reads
// [COMPLEX(x)[i].r] / [.i] then gets a precise [c_double] for each field.
COMPLEX: [v(CLX)] --> *s({ r : c_double, i : c_double })
COMPLEX_RO: [v(CLX)] --> *s({ r : c_double, i : c_double })
VECTOR_PTR_RO: [list] --> *any_sexp

// R API: misc
// length is defined in Rinlinedfuns.h
length: ([vec1] --> c(1)) & ([vec] --> c_int) & ([null] --> c(0)) & ([sym | (empty -> any) | externalptr] --> c(1)) & ([any_sexp] --> c_int)
asReal: [any] --> c_double
memcpy: [any, any, c_int] --> any
R_alloc: [c_int, c_int] --> *any // or c_ptr?
R_isort: [*c_int_na, c_int] --> c_void
shallow_duplicate: ['a] --> 'a
duplicate: ['a] --> 'a
Rf_match: [vec | null, v('a) | null, c_int] --> v(INT)

// Coercion
coerceVector: [any, 'a] --> 'a//TODO: not all coercions are possible!

MARK_NOT_MUTABLE: [any] --> c_void

// classes
inherits: [any, c_string] --> c_bool // to improve when supporting classes

// Class-checking predicates.
isFactor: ([v(INT) <factor, ...>] --> c_true) & ([any_sexp \ (v(INT) <factor, ...>)] --> c_false)
isObject: ([attr \ <>] --> c_true) & ([any_sexp \ (attr \ <>)] --> c_false)
isFrame: ([<data.frame, ...>] --> c_true) & ([any_sexp \ <data.frame, ...>] --> c_false)

// External pointers 
R_ExternalPtrAddr: ([externalptr('a)] --> *'a) & ([externalptr(empty)] --> c_null)
R_MakeExternalPtr: ([*'a, any_sexp, any_sexp] --> externalptr('a)) & ([c_null, any_sexp, any_sexp] --> externalptr(empty))

// C functions

assert: [any] --> c_void //We might differentiate between the true and false case here
