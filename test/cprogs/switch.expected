isInteger2: ([INT] -> c_true) & ([((CHR | CLX | DBL | LGL | RAW) | (~vec)<...>) | null | p(CHR) | sym] -> c_false)

isInteger3: ([INT] -> c_true) & ([((CHR | CLX | DBL | LGL | RAW) | (~vec)<...>) | null | p(CHR) | sym] -> c_false)

checkList: ([list] -> c_true) & ([(~list)<...> | null | p(CHR) | sym] -> c_false)

isVectorList: ∀'a. ([list] --> c_true) & ([(env | externalptr | lang | v('a) | arrow) | null | p(CHR) | sym] --> c_false)

length2: ([null<...>] -> c_false) & ([vec1] -> c_true) & ([vec] | [lang | null] | [list | p(CHR)] -> c_int)

length3: ([null<...>] -> c_false) & ([CHR] | [CLX] | [DBL] | [INT] | [LGL] | [p(CHR)] | [raw] -> c_int) & ([CHR1] | [CLX1] | [DBL1] | [INT1] | [LGL1] | [raw1] | [(~(null | vec))<...> | null | sym] -> c_true)

