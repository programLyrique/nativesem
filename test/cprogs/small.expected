change_int: ∀'a. ([INT & 'a] -> INT & 'a) & ([^INT1 & 'a] -> ^INT1 & 'a)

errorIntScalar: [INT1] -> ()

make_scalar: () -> INT1

isIntScalar: ([INT] -> c_bool) & ([INT1] -> c_true) & ([(~INT)<...> | null | p(CHR) | sym] -> c_false)

check: () -> c_false

incr: [INT1] -> INT1

isFunction: ([arrow] --> c_true) & ([~arrow] --> c_false)

isPrimitive: ([any -> any] -> c_true) & ([(~(any -> any))<...> | null | p(CHR) | sym] -> c_false)

isList: ([(~lang)<...> | p(CHR) | sym] -> c_false) & ([lang] | [null] -> c_true)

isNewList: ([(~list)<...> | p(CHR) | sym] -> c_false) & ([list] | [null] -> c_true)

