first_na_or_all: ∀'a,'b. ([(CHR & v('b)) & 'a] -> null | 'a & (CHR & v('b) | null)) & ([(CHR1 & v1('b)) & 'a] -> null | 'a & (CHR1 & v1('b) | null)) & (['a & ((clx & v('b) | (~vec)<...>) | null | sym)] -> empty)

count_down: ∀'a. ([vec1 & 'a] -> vec1 & 'a) & (['a & ((list | vec) | p(CHR))] -> 'a & ((list | vec) | p(CHR)))

forever: ∀'a. [any_sexp & 'a] -> any_sexp & 'a

stray: ∀'a. ([null & 'a] -> null & 'a) & (['a & (p(CHR) | sym | attr_any)] -> 'a & (p(CHR) | sym | attr_any))

