larger_than_3: ∀'a. ([INT1 & 'a] -> INT1 & 'a) & ([^INT1 & 'a] -> ^INT1 & 'a)

size_bound: ∀'a. [vec1 & 'a] -> vec1 & 'a

bail_if: ([c_false, c_string] -> ()) & ([c_int_na \ c_false, c_string] -> empty)

cond_on_int: ∀'a. [c_false & 'a] -> c_false & 'a

isNull: [*c_int_na \ c_null] -> c_false

C_escape_chars: [CHR] -> ()

C_escape_chars_one: ∀'a. [any_sexp & 'a] -> any_sexp & 'a

C_escape_chars2: ∀'a. ([CHR] -> CHR) & ([CHR1 & v1('a)] -> "" | CHR1 & v1('a))

